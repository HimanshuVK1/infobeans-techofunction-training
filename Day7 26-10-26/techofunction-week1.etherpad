850}},"pad:techofunction-week1:revs:797":{"changeset":"Z:2w5>1|51=2va=u*1+1$>","meta":{"author":"a.5Bma3U0RGBis5RkD","timestamp":1792650914403}},"pad:techofunction-week1:revs:798":{"changeset":"Z:2w6>2|51=2va=v*1+2$co","meta":{"author":"a.5Bma3U0RGBis5RkD","timestamp":1792650914985}},"pad:techofunction-week1:revs:799":{"changeset":"Z:2w8>3|51=2va=x*1+3$nte","meta":{"author":"a.5Bma3U0RGBis5RkD","timestamp":1792650915516}},"pad:techofunction-week1:revs:800":{"changeset":"Z:2wb>2|51=2va=10*1+2$nt","meta":{"author":"a.5Bma3U0RGBis5RkD","timestamp":1792650916083,"pool":{"numToAttrib":{"0":["author","a.etherpad-system"],"1":["author","a.5Bma3U0RGBis5RkD"],"2":["heading","h3"],"3":["insertorder","first"],"4":["list","bullet1"],"5":["lmkr","1"],"6":["list","indent1"],"7":["list","indent3"],"8":["start","1"],"9":["author","a.XBtqZgC04nCR1sC5"],"10":["author","a.oIZ496sC0MvFJBbg"],"11":["list","indent2"],"12":["author","a.6fEK8VUdbD4cP299"],"13":["author","a.W8SlWkw9QzdnoaRT"],"14":["heading","h2"]},"attribToNum":{"author,a.etherpad-system":0,"author,a.5Bma3U0RGBis5RkD":1,"heading,h3":2,"insertorder,first":3,"list,bullet1":4,"lmkr,1":5,"list,indent1":6,"list,indent3":7,"start,1":8,"author,a.XBtqZgC04nCR1sC5":9,"author,a.oIZ496sC0MvFJBbg":10,"list,indent2":11,"author,a.6fEK8VUdbD4cP299":12,"author,a.W8SlWkw9QzdnoaRT":13,"heading,h2":14},"nextNum":15},"atext":{"text":"*Welcome for the training on Techno functional training program\nAgenda:\n  1.  Introduction\n  2.   LET  portal \n  3.   Day schedule (9 30am to 6 30pm)\n*    11 30  (20 minutes)\n* Lunch 1 30 ( 60 minute)\n*4  (20 minute)\n*\n   4. Lab guidance\n   5. Courseware\n   6. TOC\n   \n   9664670840\n   \n*   https://linuxlab.koenig-solutions.com\n*   Pa$$w0rd\n==================================================================================================\nApllication development:\n    Monolithic: \n    Microservice:\n        \n        components:\n            1)frontend ==>dotnet==>EFcore\n\n=================================\nSQL server==>DB server\n\nSSMS ==>Db client\n\nCRUD operation\n\nblameless postmortum\n\ncode===>build===>test==>deploy===>maintain\n==========================================\nAccount required for training:\n    ------------------------------------\ngithub\ndocker hub\nredhat\n==========================================\nDatabase\nUI\n\nDTO===>ORM\n=============================================\n*Day 2: 20/10/20\n\n\nhttps://github.com/Mudassir-dev0ps/dotnetSampleApp\n\nMVC\n============================================================\nusing Microsoft.EntityFrameworkCore;\nusing OrderManagement.Models;\n \nnamespace OrderManagement.Data\n{\n    public class ApplicationDbContext : DbContext\n    {\n        public ApplicationDbContext(\n            DbContextOptions<ApplicationDbContext> options)\n            : base(options)\n        {\n        }\n \n        public DbSet<Customer> Customers { get; set; }\n \n        public DbSet<Order> Orders { get; set; }\n    }\n}\n\n\n=\ndll===> format===>published application\n=========================================\nvar builder = WebApplication.CreateBuilder(args);\n \nvar app = builder.Build();\n \napp.MapGet(\"/\", () =>\n    \"Hello! My .NET application is running.\");\n \napp.MapGet(\"/about\", () => new\n{\n    Application = \"BuildPublishDemo\",\n    Technology = \"ASP.NET Core\",\n    Status = \"Running\"\n});\n \napp.MapGet(\"/health\", () => new\n{\n    Status = \"Healthy\",\n    Time = DateTime.UtcNow\n});\n \napp.Run();\n\n============================================================================\n*Day 3: 21/10/23\n\nDay 6 – Windows Server Fundamentals\n•\nWindows Server architecture\n•\nWindows Server editions\n•\nSystem configuration\n•\nWindows Server roles\n•\nServer Manager\n•\nUsers and groups\n•\nLocal vs domain accounts\n•\nActive Directory overview\n•\nGroup concepts\n•\nUser management\n•\nHands-on user/group administration\n\n======================================================\nOS\ndependencies\nlibraries\nApp code\n===========================================\n\nIdentity management ===>Authentication=================>IAM\nAccess managennt====>Authorization\n\nAD=============>Windows\nLDAP===========>Linux\nEntra ID====>Azure\nIAM===>AWS\n============================================================\nThe participants will act as junior Windows Server administrators for a fictional company. They will configure a server, install roles, create users and groups, deploy Active Directory, and troubleshoot access and account-management issues.\n\n1 role==>UI\n1 role==powershell\n------------------------------------------\nlocal user\n2 local group\n------------------------------------------------------------\nAD\nlocal user\n2 local graoup\n------------------------------------\n===================================================================\n*Day 3 22/10/26\n*Windows Filesystem & Permissions\n•\nWindows filesystem\n•\nDrives and partitions\n•\nNTFS\n•\nFile and folder permissions\n•\nNTFS permissions\n•\nShare permissions\n•\nPermission inheritance\n•\nOwnership\n•\nAdministrative shares\n•\nDisk space troubleshooting\n=============================================\n3GB====10x3==1000\n3GiB===2x10=3072\n==========================\nFolder1==========>f1,f2===>content\nFolder2=========>f3,f4========>content\n","attribs":"*1*2*3*4*5*8+1*1|5+45*1*3*6*5+1*1|1+o*1*3*6*5+1*1|1+p*1*3*6*5+1*1|1+f*1*3*6*5+1*1|7+1x*a*3*6*5+1*1+f*a|1+q*a*3*6*5+1*a+b*1|2+2s*1+2*a+1*1|m+bo*1+6*9|1+1*1|6+35*1*2*3*5+1*1|p+fe*d|3+4*1|m+cq*1+a*d|2+2*1|1+25*1*2*3*5+1*1|u+b4*1+8*9|1+1*1|g+gt*1+a*d+1*1|7+5i*1*e*3*5+1*1|1+f*1*2*3*5+1*1|q+ar*1+12|1+1"}}},"pad:techofunction-week1:revs:801":{"changeset":"Z:2wd>1|50=2ub=y*1+1$ ","meta":{"author":"a.5Bma3U0RGBis5RkD","timestamp":1792650918382}},"pad:techofunction-week1:revs:802":{"changeset":"Z:2we>1|50=2ub=z*1+1$=","meta":{"author":"a.5Bma3U0RGBis5RkD","timestamp":1792650918933}},"pad:techofunction-week1:revs:803":{"changeset":"Z:2wf>c|50=2ub=10*1+c$=