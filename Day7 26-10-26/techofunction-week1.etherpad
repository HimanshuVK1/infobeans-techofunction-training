"1"],"9":["author","a.XBtqZgC04nCR1sC5"],"10":["author","a.oIZ496sC0MvFJBbg"],"11":["list","indent2"],"12":["author","a.6fEK8VUdbD4cP299"],"13":["author","a.W8SlWkw9QzdnoaRT"]},"attribToNum":{"author,a.etherpad-system":0,"author,a.5Bma3U0RGBis5RkD":1,"heading,h3":2,"insertorder,first":3,"list,bullet1":4,"lmkr,1":5,"list,indent1":6,"list,indent3":7,"start,1":8,"author,a.XBtqZgC04nCR1sC5":9,"author,a.oIZ496sC0MvFJBbg":10,"list,indent2":11,"author,a.6fEK8VUdbD4cP299":12,"author,a.W8SlWkw9QzdnoaRT":13},"nextNum":14},"atext":{"text":"*Welcome for the training on Techno functional training program\nAgenda:\n  1.  Introduction\n  2.   LET  portal \n  3.   Day schedule (9 30am to 6 30pm)\n*    11 30  (20 minutes)\n* Lunch 1 30 ( 60 minute)\n*4  (20 minute)\n*\n   4. Lab guidance\n   5. Courseware\n   6. TOC\n   \n   9664670840\n   \n*   https://linuxlab.koenig-solutions.com\n*   Pa$$w0rd\n==================================================================================================\nApllication development:\n    Monolithic: \n    Microservice:\n        \n        components:\n            1)frontend ==>dotnet==>EFcore\n\n=================================\nSQL server==>DB server\n\nSSMS ==>Db client\n\nCRUD operation\n\nblameless postmortum\n\ncode===>build===>test==>deploy===>maintain\n==========================================\nAccount required for training:\n    ------------------------------------\ngithub\ndocker hub\nredhat\n==========================================\nDatabase\nUI\n\nDTO===>ORM\n=============================================\n*Day 2: 20/10/20\n\n\nhttps://github.com/Mudassir-dev0ps/dotnetSampleApp\n\nMVC\n============================================================\nusing Microsoft.EntityFrameworkCore;\nusing OrderManagement.Models;\n \nnamespace OrderManagement.Data\n{\n    public class ApplicationDbContext : DbContext\n    {\n        public ApplicationDbContext(\n            DbContextOptions<ApplicationDbContext> options)\n            : base(options)\n        {\n        }\n \n        public DbSet<Customer> Customers { get; set; }\n \n        public DbSet<Order> Orders { get; set; }\n    }\n}\n\n\n=\ndll===> format===>published application\n=========================================\nvar builder = WebApplication.CreateBuilder(args);\n \nvar app = builder.Build();\n \napp.MapGet(\"/\", () =>\n    \"Hello! My .NET application is running.\");\n \napp.MapGet(\"/about\", () => new\n{\n    Application = \"BuildPublishDemo\",\n    Technology = \"ASP.NET Core\",\n    Status = \"Running\"\n});\n \napp.MapGet(\"/health\", () => new\n{\n    Status = \"Healthy\",\n    Time = DateTime.UtcNow\n});\n \napp.Run();\n\n============================================================================\n*Day 3: 21/10/23\n\nDay 6 – Windows Server Fundamentals\n•\nWindows Server architecture\n•\nWindows Server editions\n•\nSystem configuration\n•\nWindows Server roles\n•\nServer Manager\n•\nUsers and groups\n•\nLocal vs domain accounts\n•\nActive Directory overview\n•\nGroup concepts\n•\nUser management\n•\nHands-on user/group administration\n\n======================================================\nOS\ndependencies\nlibraries\nApp code\n===========================================\n\nIdentity management ===>Authentication=================>IAM\nAccess managennt====>Authorization\n\nAD=============>Windows\nLDAP===========>Linux\nEntra ID====>Azure\nIAM===>AWS\n============================================================\nThe participants will act as junior Windows Server administrators for a fictional company. They will configure a server, install roles, create users and groups, deploy Active Directory, and troubleshoot access and account-management issues.\n\n1 role==>UI\n1 role==powershell\n------------------------------------------\nlocal user\n2 local graoup\n------------------------------------------------------------\nAD\nlocal user\n2 local graoup\n-----\n\n","attribs":"*1*2*3*4*5*8+1*1|5+45*1*3*6*5+1*1|1+o*1*3*6*5+1*1|1+p*1*3*6*5+1*1|1+f*1*3*6*5+1*1|7+1x*a*3*6*5+1*1+f*a|1+q*a*3*6*5+1*a+b*1|2+2s*1+2*a+1*1|m+bo*1+6*9|1+1*1|6+35*1*2*3*5+1*1|p+fe*d|3+4*1|m+cq*1+a*d|2+2*1|1+25*1*2*3*5+1*1|u+b4*1+8*9|1+1*1|m+jw|1+1"}}},"pad:techofunction-week1:revs:701":{"changeset":"Z:2hd>i|48=2h6=5*1+i$------------------","meta":{"author":"a.5Bma3U0RGBis5RkD","timestamp":1792583373114}},"pad:techofunction-week1:revs:702":{"changeset":"Z:2hv>d|48=2h6=n*1+d$-------------","meta":{"author":"a.5Bma3U0RGBis5RkD","timestamp":1792583373659}},"pad:techofunction-week1:revs:703":{"changeset":"Z:2i8<1|43=2e9=b-1$","meta":{"author":"a.W8SlWkw9QzdnoaRT","timestamp":1792585073443}},"pad:techofunction-week1:revs:704":{"changeset":"Z:2i7<1|43=2e9=a-1$","meta":{"author":"a.W8SlWkw9QzdnoaRT","timestamp":1792585074022}},"pad:techofunction-week1:revs:705":{"changeset":"Z:2i6>1|43=2e9=a*d+1$o","meta":{"author":"a.W8SlWkw9QzdnoaRT","timestamp":1792585074771}},"pad:techofunction-week1:revs:706":{"changeset":"Z:2i7>1|49=2i6*1+1$=","meta":{"author":"a.5Bma3U0RGBis5RkD","timestamp":1792642282502}},"pad:techofunction-week1:revs:707":{"changeset":"Z:2i8>5|49=2i6=1*1+5$=====","meta":{"author":"a.5Bma3U0RGBis5RkD","timestamp":1792642283115}},"pad:techofunction-week1:revs:708":{"changeset":"Z:2id>j|49=2i6=6*1+j$===================","meta":{"author":"a.5Bma3U0RGBis5RkD","timestamp":1792642285696}},"pad:techofunction-week1:revs:709":{"changeset":"Z:2iw>17|49=2i6=p*1|1+17$==========================================\n","meta":{"author":"a.5Bma3U0RGBis5RkD","timestamp":1792642286815}},"pad:techofunction-week1:revs:710":{"changeset":"Z:2k3>1|4a=2k2*1+1$D","meta":{"author":"a.5Bma3U0RGBis5RkD","timestamp":1792642303769}},"pad:techofunction-week1:revs:711":{"changeset":"Z:2k4>2|4a=2k2=1*1+2$ay","meta":{"author":"a.5Bma3U0RGBis5RkD","timestamp":1792642304362}},"pad:techofunction-week1:revs:712":{"changeset":"Z:2k6>1|4a=2k2=3*1+1$ ","meta":{"author":"a.5Bma3U0RGBis5RkD","timestamp":1792642305412}},"pad:techofunction-week1:revs:713":{"changeset":"Z:2k7>1|4a