eek1:revs:1447":{"changeset":"Z:5rv<3|8s=5rf=b-3$","meta":{"author":"a.Fln8zZWwNdatIBJx","timestamp":1792738196800}},"pad:techofunction-week1:revs:1448":{"changeset":"Z:5rs<5|8s=5rf=6-5$","meta":{"author":"a.Fln8zZWwNdatIBJx","timestamp":1792738197455}},"pad:techofunction-week1:revs:1449":{"changeset":"Z:5rn<3|8s=5rf=3-3$","meta":{"author":"a.Fln8zZWwNdatIBJx","timestamp":1792738198105}},"pad:techofunction-week1:revs:1450":{"changeset":"Z:5rk<2|8s=5rf=1-2$","meta":{"author":"a.Fln8zZWwNdatIBJx","timestamp":1792738198746}},"pad:techofunction-week1:revs:1451":{"changeset":"Z:5ri<1|8s=5rf-1$","meta":{"author":"a.Fln8zZWwNdatIBJx","timestamp":1792738199803}},"pad:techofunction-week1:revs:1452":{"changeset":"Z:5rh<1|8r=5re|1-1$","meta":{"author":"a.Fln8zZWwNdatIBJx","timestamp":1792738200425}},"pad:techofunction-week1:revs:1453":{"changeset":"Z:5rg>1|8p=5q8=14*r|1+1$\n","meta":{"author":"a.4UVIp0q8OaxadHwV","timestamp":1792738268075}},"pad:techofunction-week1:revs:1454":{"changeset":"Z:5rh>1|8q=5rd*r|1+1$\n","meta":{"author":"a.4UVIp0q8OaxadHwV","timestamp":1792738268744}},"pad:techofunction-week1:revs:1455":{"changeset":"Z:5ri>13w|8r=5re*r+13w$ $url = \"https://www.python.org/ftp/python/3.14.2/python-3.14.2-amd64.exe\"...                                                                               2 python --version                                                                                                                                           3 Start-Process \"$env:TEMP\\python-installer.exe\" -ArgumentList \"/quiet InstallAllUsers=0 PrependPath=1 Include_test=0\" -Wait                                 4 py --version                                                                                                                                               5 python --version                                                                                                                                           6 Test-Path \"$env:TEMP\\python-installer.exe\"...                                                                                                              7 Get-ChildItem \"$env:LOCALAPPDATA\\Programs\\Python\" -ErrorAction SilentlyContinue                                                                            8 $pythonDir = \"$env:LOCALAPPDATA\\Programs\\Python\\Python314\"...                                                                                              9 python --version...                                                                                                                                       10 python --version      ","meta":{"author":"a.4UVIp0q8OaxadHwV","timestamp":1792738270068}},"pad:techofunction-week1:revs:1456":{"changeset":"Z:6ve<1|8r=5re=13v-1$","meta":{"author":"a.4UVIp0q8OaxadHwV","timestamp":1792738284166}},"pad:techofunction-week1:revs:1457":{"changeset":"Z:6vd<2|8r=5re=13t-2$","meta":{"author":"a.4UVIp0q8OaxadHwV","timestamp":1792738284862}},"pad:techofunction-week1:revs:1458":{"changeset":"Z:6vb<9|8r=5re=13k-9$","meta":{"author":"a.4UVIp0q8OaxadHwV","timestamp":1792738285505}},"pad:techofunction-week1:revs:1459":{"changeset":"Z:6v2<13k|8r=5re-13k$","meta":{"author":"a.4UVIp0q8OaxadHwV","timestamp":1792738289936}},"pad:techofunction-week1:revs:1460":{"changeset":"Z:5ri>o|8r=5re*q|1+o$ Google Coral Edge TPU.\n","meta":{"author":"a.Fln8zZWwNdatIBJx","timestamp":1792738370386}},"pad:techofunction-week1:revs:1461":{"changeset":"Z:5s6<1|8s=5s2|1-1$","meta":{"author":"a.Fln8zZWwNdatIBJx","timestamp":1792738371691}},"pad:techofunction-week1:revs:1462":{"changeset":"Z:5s5<4|8r=5re=k|1-4$","meta":{"author":"a.Fln8zZWwNdatIBJx","timestamp":1792738372337}},"pad:techofunction-week1:revs:1463":{"changeset":"Z:5s1<5|8r=5re=f-5$","meta":{"author":"a.Fln8zZWwNdatIBJx","timestamp":1792738372979}},"pad:techofunction-week1:revs:1464":{"changeset":"Z:5rw<5|8r=5re=a-5$","meta":{"author":"a.Fln8zZWwNdatIBJx","timestamp":1792738373650}},"pad:techofunction-week1:revs:1465":{"changeset":"Z:5rr<4|8r=5re=6-4$","meta":{"author":"a.Fln8zZWwNdatIBJx","timestamp":1792738374312}},"pad:techofunction-week1:revs:1466":{"changeset":"Z:5rn<3|8r=5re=3-3$","meta":{"author":"a.Fln8zZWwNdatIBJx","timestamp":1792738374949}},"pad:techofunction-week1:revs:1467":{"changeset":"Z:5rk<1|8r=5re=2-1$","meta":{"author":"a.Fln8zZWwNdatIBJx","timestamp":1792738375595}},"pad:techofunction-week1:revs:1468":{"changeset":"Z:5rj<1|8r=5re=1-1$","meta":{"author":"a.Fln8zZWwNdatIBJx","timestamp":1792738376297}},"pad:techofunction-week1:revs:1469":{"changeset":"Z:5ri>4f|8r=5re*r+4f$ $url = \"https://www.python.org/ftp/python/3.14.2/python-3.14.2-amd64.exe\"            >> Invoke-WebRequest -Uri $url -OutFile \"$env:TEMP\\python-installer.exe\" ","meta":{"author":"a.4UVIp0q8OaxadHwV","timestamp":1792738382786}},"pad:techofunction-week1:revs:1470":{"changeset":"Z:5vx>2|8r=5re=4g*r|1+1*r+1$\n ","meta":{"author":"a.4UVIp0q8OaxadHwV","timestamp":1792738388109}},"pad:techofunction-week1:revs:1471":{"changeset":"Z:5vz>2|8s=5vv=1*r|1+1*r+1$\n ","meta":{"author":"a.4UVIp0q8OaxadHwV","timestamp":1792738388981}},"pad:techofunction-week1:revs:1472":{"changeset":"Z:5w1>d7|8t=5vx=1*r|i+bx*r+1a$$pythonDir = \"$env:LOCALAPPDATA\\Programs\\Python\\Python314\"\n$scriptsDir = \"$pythonDir\\Scripts\"\n\n$userPath = [Environment]::GetEnvironmentVariable(\"Path\", \"User\")\n$entries = @($userPath -split ';' | Where-Object { $_ })\n\nforeach ($dir in @($pythonDir, $scriptsDir)) {\n    if ($entries -notcontains $dir) {\n        $entries += $dir\n    }\n}\n\n[Environment]::SetEnvironmentVariable(\n    \"Path\",\n    ($entries -join ';'),\n    \"User\"\n)\n\n$env:Path = \"$pythonDir;$scriptsDir;$env:Path\"","meta":{"author":"a.4UVIp0q8OaxadHwV","timestamp":1792738518178}},"pad:techofunction-week1:revs:1473":{"changeset":"Z:698>1|8r=5re=1*r+1$1","meta":{"author":"a.4UVIp0q8OaxadHwV","timestamp":1792738524525}},"pad:techofunction-week1:revs:1474":{"changeset":"Z:699>2|8r=5re=2*r+2$ -","meta":{"author":"a.4UVIp0q