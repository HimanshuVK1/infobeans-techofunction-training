-week1:revs:1357":{"changeset":"Z:4x9>1|7m=4wo=j*1|1+1$\n","meta":{"author":"a.5Bma3U0RGBis5RkD","timestamp":1792736840092}},"pad:techofunction-week1:revs:1358":{"changeset":"Z:4xa>av|7o=4x9*1|k+av$import time\n\ndef task_a():\n    for i in range(1, 6):\n        print(f\"Task A: Processing step {i}\")\n        time.sleep(1)  # Simulate waiting or I/O\n\ndef task_b():\n    for i in range(1, 6):\n        print(f\"Task B: Processing step {i}\")\n        time.sleep(1)  # Simulate waiting or I/O\n\nprint(\"Starting Task A\")\ntask_a()\n\nprint(\"\\nStarting Task B\")\ntask_b()\n\nprint(\"\\nBoth tasks completed.\")\n\n","meta":{"author":"a.5Bma3U0RGBis5RkD","timestamp":1792736847272}},"pad:techofunction-week1:revs:1359":{"changeset":"Z:585>1|87=583*1+1$=","meta":{"author":"a.5Bma3U0RGBis5RkD","timestamp":1792736850323}},"pad:techofunction-week1:revs:1360":{"changeset":"Z:586>s|87=583=1*1+s$============================","meta":{"author":"a.5Bma3U0RGBis5RkD","timestamp":1792736851606}},"pad:techofunction-week1:revs:1361":{"changeset":"Z:58y>f|87=583=t*1+f$===============","meta":{"author":"a.5Bma3U0RGBis5RkD","timestamp":1792736852307}},"pad:techofunction-week1:revs:1362":{"changeset":"Z:59d>1|87=583=18*1|1+1$\n","meta":{"author":"a.5Bma3U0RGBis5RkD","timestamp":1792736852904}},"pad:techofunction-week1:revs:1363":{"changeset":"Z:59e<c2|7o=4x9|j-au-18$","meta":{"author":"a.5Bma3U0RGBis5RkD","timestamp":1792736954122}},"pad:techofunction-week1:revs:1364":{"changeset":"Z:4xc<1|7l=4vt=f-1$","meta":{"author":"a.oIZ496sC0MvFJBbg","timestamp":1792736983131}},"pad:techofunction-week1:revs:1365":{"changeset":"Z:4xb<6|7l=4vt=9-6$","meta":{"author":"a.oIZ496sC0MvFJBbg","timestamp":1792736983813}},"pad:techofunction-week1:revs:1366":{"changeset":"Z:4x5<3|7l=4vt=6-3$","meta":{"author":"a.oIZ496sC0MvFJBbg","timestamp":1792736984485}},"pad:techofunction-week1:revs:1367":{"changeset":"Z:4x2<1|7l=4vt=5-1$","meta":{"author":"a.oIZ496sC0MvFJBbg","timestamp":1792736985069}},"pad:techofunction-week1:revs:1368":{"changeset":"Z:4x1>1|7l=4vt=5*a+1$t","meta":{"author":"a.oIZ496sC0MvFJBbg","timestamp":1792736985821}},"pad:techofunction-week1:revs:1369":{"changeset":"Z:4x2>3|7l=4vt=6*a+3$hre","meta":{"author":"a.oIZ496sC0MvFJBbg","timestamp":1792736986479}},"pad:techofunction-week1:revs:1370":{"changeset":"Z:4x5>4|7l=4vt=9*a+4$adin","meta":{"author":"a.oIZ496sC0MvFJBbg","timestamp":1792736987146}},"pad:techofunction-week1:revs:1371":{"changeset":"Z:4x9>1|7l=4vt=d*a+1$g","meta":{"author":"a.oIZ496sC0MvFJBbg","timestamp":1792736987806}},"pad:techofunction-week1:revs:1372":{"changeset":"Z:4xa>a3|7n=4x6*a|b+8g*a+1n$import threading, time\n\ndef task(n):\n    print(f\"Task {n} started\")\n    time.sleep(2)          # simulates waiting (API/DB call)\n    print(f\"Task {n} done\")\n\nstart = time.time()\nthreads = [threading.Thread(target=task, args=(i,)) for i in range(4)]\nfor t in threads: t.start()\nfor t in threads: t.join()\nprint(f\"Total: {time.time() - start:.1f}s\")   # ~2s, not 8s","meta":{"author":"a.oIZ496sC0MvFJBbg","timestamp":1792736989529}},"pad:techofunction-week1:revs:1373":{"changeset":"Z:57d>1|7y=55m=1n*a|1+1$\n","meta":{"author":"a.oIZ496sC0MvFJBbg","timestamp":1792736990536}},"pad:techofunction-week1:revs:1374":{"changeset":"Z:57e>1|7z=57a*a|1+1$\n","meta":{"author":"a.oIZ496sC0MvFJBbg","timestamp":1792736991183}},"pad:techofunction-week1:revs:1375":{"changeset":"Z:57f>1|80=57b*a+1$=","meta":{"author":"a.oIZ496sC0MvFJBbg","timestamp":1792736992444}},"pad:techofunction-week1:revs:1376":{"changeset":"Z:57g>6|80=57b=1*a+6$======","meta":{"author":"a.oIZ496sC0MvFJBbg","timestamp":1792736993102}},"pad:techofunction-week1:revs:1377":{"changeset":"Z:57m>m|80=57b=7*a+m$======================","meta":{"author":"a.oIZ496sC0MvFJBbg","timestamp":1792736993822}},"pad:techofunction-week1:revs:1378":{"changeset":"Z:588>m|80=57b=t*a+m$======================","meta":{"author":"a.oIZ496sC0MvFJBbg","timestamp":1792736994483}},"pad:techofunction-week1:revs:1379":{"changeset":"Z:58u>2|80=57b=1f*a+2$==","meta":{"author":"a.oIZ496sC0MvFJBbg","timestamp":1792736995129}},"pad:techofunction-week1:revs:1380":{"changeset":"Z:58w>2|80=57b=1h*a|2+2$\n\n","meta":{"author":"a.oIZ496sC0MvFJBbg","timestamp":1792736995779}},"pad:techofunction-week1:revs:1381":{"changeset":"Z:58y>1|82=58u*a+1$M","meta":{"author":"a.oIZ496sC0MvFJBbg","timestamp":1792737008254}},"pad:techofunction-week1:revs:1382":{"changeset":"Z:58z>3|82=58u=1*a+3$ult","meta":{"author":"a.oIZ496sC0MvFJBbg","timestamp":1792737008958}},"pad:techofunction-week1:revs:1383":{"changeset":"Z:592>4|82=58u=4*a+4$ipro","meta":{"author":"a.oIZ496sC0MvFJBbg","timestamp":1792737009626}},"pad:techofunction-week1:revs:1384":{"changeset":"Z:596>4|82=58u=8*a+4$cess","meta":{"author":"a.oIZ496sC0MvFJBbg","timestamp":1792737010301}},"pad:techofunction-week1:revs:1385":{"changeset":"Z:59a>4|82=58u=c*a+4$ing ","meta":{"author":"a.oIZ496sC0MvFJBbg","timestamp":1792737010949}},"pad:techofunction-week1:revs:1386":{"changeset":"Z:59e>1|82=58u=g*a+1$.","meta":{"author":"a.oIZ496sC0MvFJBbg","timestamp":1792737011623}},"pad:techofunction-week1:revs:1387":{"changeset":"Z:59f>1|82=58u=h*a|1+1$\n","meta":{"author":"a.oIZ496sC0MvFJBbg","timestamp":1792737012457}},"pad:techofunction-week1:revs:1388":{"changeset":"Z:59g>bl|83=59c*a|e+aa*a+1b$\nimport multiprocessing, time\n\ndef burn_cpu(n):\n    total = 0\n    for i in range(30_000_000):\n        total += i * i\n    print(f\"Process {n} done\")\n\nif __name__ == \"__main__\":      # required on Windows\n    start = time.time()\n    procs = [multiprocessing.Process(target=burn_cpu, args=(i,)) for i in range(4)]\n    for p in procs: p.start()\n    for p in procs: p.join()\n    print(f\"Total: {time.time() - start:.1f}s\")","meta":{"author":"a.oIZ496sC0MvFJBbg","timestamp":1792737013112}},"pad:techofunction-week1:revs:1389":{"changeset":"Z:5l1>1|8j=5kz*1+1$=","meta":{"author":"a.5Bma3U0RGBis5RkD","timestamp":1792737034677}},"pad:techofunction-week1:revs:1390":{"changeset":"Z:5l2>3|8j=5kz=1*1+3$===","meta":{"author":"a.5Bma3U0RGBis5RkD","timestamp":1792737035264}},"pad:techofunction-week1:revs:1391":{"changeset":"Z:5l5>j|8j=5kz=4*1+j$===================","meta":{"author":"a.5Bma3U0RGBis5RkD","timestamp":1792737035819}},"pad:techofunction-week1:revs:1392":{"changeset":"Z:5lo>i|8j=5kz=n*1+i$==================","meta":{"author":"a.5Bma3U0RGBis5RkD","timestamp":1792737036374}},"pad:techofunction-week1:revs:1393":{"changeset":"Z:5m6>i|8j=5kz=15*1+i$==================","meta":{"author":"a.5Bma3U0RGBis5RkD","timestamp":1792737036928}},"pad:techofunction-week1:revs:1394":{"changeset":"Z:5mo>1|8j=5kz=1n*1+1$=","meta":{"author":"a.5Bma3U0RGBis5RkD","timestamp":1792737037486}},"pad:techofunction-week1:revs:1395":{"changeset":"Z:5mp>1|8k=5mo*a|1+1$\n","meta":{"author":"a.oIZ496sC0MvFJBbg","timestamp":1792737214160}},"pad:techofunction-week1:revs:1396":{"changeset":"Z:5mq>2n|8l=5mp*a|1+1*a+2m$\nAdd-AppxPackage -RegisterByFamilyName -MainPackage Microsoft.DesktopAppInstaller_8wekyb3d8bbwe","meta":{"author":"a.oIZ496sC0MvFJBbg","timestamp":1792737214838}},"pad:techofunction-week1:revs:1397":{"changeset":"Z:5pd<2m|8m=5mq-2m$","meta":{"author":"a.v1tf3cnZGGlguTDX","timestamp":1792737261754}},"pad:techofunction-week1:revs:1398":{"changeset":"Z:5mr<1|8l=5mp|1-1$","meta":{"author":"a.v1tf3cnZGGlguTDX","timestamp":1792737262488}},"pad:techofunction-week1:revs:1399":{"changeset":"Z:5mq>14|8l=5mp*l+14$Python Releases for Windows | Python.org","meta":{"author":"a.v1tf3cnZGGlguTDX","timestamp":1792737317447}},"pad:techofunction-week1:revs:1400":{"changeset":"Z:5nu>5|7i=4s0=v*1|1+1*1+4$\n    ","meta":{"author":"a.5Bma3U0RGBis5RkD","timestamp":1792737391912,"pool":{"numToAttrib":{"0":["author","a.etherpad-system"],"1":["author","a.5Bma3U0RGBis5RkD"],"2":["heading","h3"],"3":["insertorder","first"],"4":["list","bullet1"],"5":["lmkr","1"],"6":["list","indent1"],"7":["list","indent3"],"8":["start","1"],"9":["author","a.XBtqZgC04nCR1sC5"],"10":["author","a.oIZ496sC0MvFJBbg"],"11":["list","indent2"],"12":["author","a.6fEK8VUdbD4cP299"],"13":["author","a.W8SlWkw9QzdnoaRT"],"14":["heading","h2"],"15":["list","indent4"],"16":["list","indent10"],"17":["list","indent9"],"18":["list","indent8"],"19":["list","indent7"],"20":["list","indent6"],"21":["author","a.v1tf3cnZGGlguTDX"],"22":["author","a.xz6wKKS5j76kPjlD"],"23":["author","a.rS0d1d8BEKDUrt1E"],"24":["heading","h4"],"25":["author","a.aMGFTUQcz8IEZ3mm"]},"attribToNum":{"author,a.etherpad-system":0,"author,a.5Bma3U0RGBis5RkD":1,"heading,h3":2,"insertorder,first":3,"list,bullet1":4,"lmkr,1":5,"list,indent1":6,"list,indent3":7,"start,1":8,"author,a.XBtqZgC04nCR1sC5":9,"author,a.oIZ496sC0MvFJBbg":10,"list,indent2":11,"author,a.6fEK8VUdbD4cP299":12,"author,a.W8SlWkw9QzdnoaRT":13,"heading,h2":14,"list,indent4":15,"list,indent10":16,"list,indent9":17,"list,indent8":18,"list,indent7":19,"list,indent6":20,"author,a.v1tf3cnZGGlguTDX":21,"author,a.xz6wKKS5j76kPjlD":22,"author,a.rS0d1d8BEKDUrt1E":23,"heading,h4":24,"author,a.aMGFTUQcz8IEZ3mm":25},"nextNum":26},"atext":{"text":"*Welcome for the training on Techno functional training program\nAgenda:\n  1.  Introduction\n  2.   LET  portal \n  3.   Day schedule (9 30am to 6 30pm)\n*    11 30  (20 minutes)\n* Lunch 1 30 ( 60 minute)\n*4  (20 minute)\n*\n   4. Lab guidance\n   5. Courseware\n   6. TOC\n   \n   9664670840\n   \n*   https://linuxlab.koenig-solutions.com\n*   Pa$$w0rd\n==================================================================================================\nApllication development:\n    Monolithic: \n    Microservice:\n        \n        components:\n            1)frontend ==>dotnet==>EFcore\n\n=================================\nSQL server==>DB server\n\nSSMS ==>Db client\n\nCRUD operation\n\nblameless postmortum\n\ncode===>build===>test==>deploy===>maintain\n==========================================\nAccount required for training:\n    ------------------------------------\ngithub\ndocker hub\nredhat\n==========================================\nDatabase\nUI\n\nDTO===>ORM\n=============================================\n*Day 2: 20/10/20\n\n\nhttps://github.com/Mudassir-dev0ps/dotnetSampleApp\n\nMVC\n============================================================\nusing Microsoft.EntityFrameworkCore;\nusing OrderManagement.Models;\n \nnamespace OrderManagement.Data\n{\n    public class ApplicationDbContext : DbContext\n    {\n        public ApplicationDbContext(\n            DbContextOptions<ApplicationDbContext> options)\n            : base(options)\n        {\n        }\n \n        public DbSet<Customer> Customers { get; set; }\n \n        public DbSet<Order> Orders { get; set; }\n    }\n}\n\n\n=\ndll===> format===>published application\n=========================================\nvar builder = WebApplication.CreateBuilder(args);\n \nvar app = builder.Build();\n \napp.MapGet(\"/\", () =>\n    \"Hello! My .NET application is running.\");\n \napp.MapGet(\"/about\", () => new\n{\n    Application = \"BuildPublishDemo\",\n    Technology = \"ASP.NET Core\",\n    Status = \"Running\"\n});\n \napp.MapGet(\"/health\", () => new\n{\n    Status = \"Healthy\",\n    Time = DateTime.UtcNow\n});\n \napp.Run();\n\n============================================================================\n*Day 3: 21/10/23\n\nDay 6 – Windows Server Fundamentals\n•\nWindows Server architecture\n•\nWindows Server editions\n•\nSystem configuration\n•\nWindows Server roles\n•\nServer Manager\n•\nUsers and groups\n•\nLocal vs domain accounts\n•\nActive Directory overview\n•\nGroup concepts\n•\nUser management\n•\nHands-on user/group administration\n\n======================================================\nOS\ndependencies\nlibraries\nApp code\n===========================================\n\nIdentity management ===>Authentication=================>IAM\nAccess managennt====>Authorization\n\nAD=============>Windows\nLDAP===========>Linux\nEntra ID====>Azure\nIAM===>AWS\n============================================================\nThe participants will act as junior Windows Server administrators for a fictional company. They will configure a server, install roles, create users and groups, deploy Active Directory, and troubleshoot access and account-management issues.\n\n1 role==>UI\n1 role==powershell\n------------------------------------------\nlocal user\n2 local group\n------------------------------------------------------------\nAD\nlocal user\n2 local graoup\n------------------------------------\n===================================================================\n*Day 3 22/10/26\n*Windows Filesystem & Permissions\n•\nWindows filesystem\n•\nDrives and partitions\n•\nNTFS\n•\nFile and folder permissions\n•\nNTFS permissions\n•\nShare permissions\n•\nPermission inheritance\n•\nOwnership\n•\nAdministrative shares\n•\nDisk space troubleshooting\n=============================================\n3GB====10x3==1000\n3GiB===2x10=3072\n==========================\nFolder1==========>f1,f2===>content ===================>UI\nFolder2=========>f3,f4========>content===========>Powershell\n\n*Access:          Folder          FIles\n    Read                  \n    Write \n    Execute \n    \n    ACL====> access control list          \n    ACE   \n    \n    icacls (powershell command for ACL access)\n    https://learn.microsoft.com/en-us/windows-server/administration/windows-commands/icacls#:~:text=A%20sequence%20of%20simple%20rights,%2D%20Read%20and%20execute%20access\n    \n    \n#icacls C:\\NTFSDemo\\Finance /grant \"FinanceLab:(OI)(CI)M\"\n\n---------------------------------------------------------------------------------------------\n\n    \n    Learning principle\n    1)simple to complex\n    2)real to imaginary\n    3)part to whole\n    \n    =====================================================\n    Ownership:\n    -------------------------\n    \n    \n    \n \n------------------------------------------------------------\nRDP\n  \n   run -> sysdm.cpl ->remote-> allow remote connection to this computer\n\n  RDP-  Enable-NetFirewallRule -DisplayGroup \"Remote Desktop\" |  Select-Object DisplayName, Enabled, Profile\n  \n  Add user to Remote Desktop User group in win22 VM\n-----------------------------------------------------------\n\n    ================================\n    Network file sharing\n    \n    SMB\n\noct19jr-tfaodp\nPa$$w0rdR#    RDP-  Enable-NetFirewallRule -DisplayGroup \"Remote Desktop\" |  Select-Object DisplayName, Enabled, Profile\n    \n   --------------------------------------\n \nAdministrative shares:\n       \nC$     Access the C: drive remotely\n        \nD$       Access the D: drive remotely, if available\n        \nADMIN$   Access the Windows installation directory, usually  C:\\Windows\n=========================================================================================\n*Day5 23/10/26    \n    \n*Windows Processes & Services\n\nProcesses\nThreads Services\nService dependencies\nWindows Services console\nTask Manager\nResource Monitor\nCPU troubleshooting\nMemory troubleshooting\nService startup failures\nService recovery\n===========================================================\nProcess vs Program\n\nmultiprogramming vs multiprocessing\n\nwindows==>run===>dxdiag\n\nProcess & Parent Process ->\n Get-CimInstance Win32_Process | Select-Object Name, ProcessId, @{Name=\"ParentName\"; Expression={(Get-CimInstance Win32_Process -Filter \"ProcessId = $($_.ParentProcessId)\").Name}}, ParentProcessId | Format-Table -AutoSize\n\n\ntasklist /svc\n\n\nTypes of processes:\n    1)foreground: 80% resource\n    2)background: 20 % resource\n    \n\n-------------------------------------------------------------------------------------------------------\nMultithreading demonstration\n-------------------\nimport threading, time\n\ndef task(n):\n    print(f\"Task {n} started\")\n    time.sleep(2)          # simulates waiting (API/DB call)\n    print(f\"Task {n} done\")\n\nstart = time.time()\nthreads = [threading.Thread(target=task, args=(i,)) for i in range(4)]\nfor t in threads: t.start()\nfor t in threads: t.join()\nprint(f\"Total: {time.time() - start:.1f}s\")   # ~2s, not 8s\n\n=====================================================\n\nMultiprocessing .\n\nimport multiprocessing, time\n\ndef burn_cpu(n):\n    total = 0\n    for i in range(30_000_000):\n        total += i * i\n    print(f\"Process {n} done\")\n\nif __name__ == \"__main__\":      # required on Windows\n    start = time.time()\n    procs = [multiprocessing.Process(target=burn_cpu, args=(i,)) for i in range(4)]\n    for p in procs: p.start()\n    for p in procs: p.join()\n    print(f\"Total: {time.time() - start:.1f}s\")\n\n============================================================\n\nPython Releases for Windows | Python.org\n","attribs":"*1*2*3*4*5*8+1*1|5+45*1*3*6*5+1*1|1+o*1*3*6*5+1*1|1+p*1*3*6*5+1*1|1+f*1*3*6*5+1*1|7+1x*a*3*6*5+1*1+f*a|1+q*a*3*6*5+1*a+b*1|2+2s*1+2*a+1*1|m+bo*1+6*9|1+1*1|6+35*1*2*3*5+1*1|p+fe*d|3+4*1|m+cq*1+a*d|2+2*1|1+25*1*2*3*5+1*1|u+b4*1+8*9|1+1*1|g+gt*1+a*d+1*1|7+5i*1*e*3*5+1*1|1+f*1*2*3*5+1*1|s+d4*1*3*6*5+1*1|b+ai*1+4*a|1+1*1|4+4a*a|1+5*a+4*1|3+1v*1+j*a|2+6*a+4*1|2+1x*1+t*a|c+7j*a+1f*9|1+1*a|1+1o*1|4+1w*1+7*l|1+1*a|1+1*m+e*1|1+1*1+a*a+4*n+2y*a|2+6*a+3*1|3+1s*1+2*a+1*1|7+7l*1*e*3*5+1*1+h*a|1+1*a+4*1|1+1*1*o*3*5+1*m+s*1|i+97*9|1+1*a|2+6y*p|2+2*p+d*a|3+3*1|3+2b*1+4*a|2+2*a+u*1|1+22*1+5*a+9*1|2+z*a|v+ns*1|2+1q*a|1+1*l+14|1+1"}}},"pad:techofunction-week1:revs:1401":{"changeset":"Z:5nz>1|7j=4sw=4*1+1$=","meta":{"author":"a.5Bma3U0RGBis5RkD","timestamp":1792737392509}},"pad:techofunction-week1:revs:1402":{"changeset":"Z:5o0>9|7j=4sw=5*1+9$=========","meta":{"author":"a.5Bma3U0RGBis5RkD","timestamp":1792737393000}},"pad:techofunction-week1:revs:1403":{"changeset":"Z:5o9>i|7j=4sw=e*1+i$==================","meta":{"author":"a.5Bma3U0RGBis5RkD","timestamp":1792737393601}},"pad:techofunction-week1:revs:1404":{"changeset":"Z:5or>i|7j=4sw=w*1+i$==================","meta":{"author":"a.5Bma3U0RGBis5RkD","timestamp":