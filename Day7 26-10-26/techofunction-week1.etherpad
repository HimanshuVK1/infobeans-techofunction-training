:390":{"changeset":"Z:16v<7b|1i=v4|h-bl-1*1|3+47*1+4${\n  \"ConnectionStrings\": {\n    \"DefaultConnection\": \"Server=localhost;Database=OrderManagementDb;Trusted_Connection=True;TrustServerCertificate=True;\"\n  },","meta":{"author":"a.5Bma3U0RGBis5RkD","timestamp":1792479785642}},"pad:techofunction-week1:revs:391":{"changeset":"Z:zk>fz|1i=v4|3-47-4*1|w+k0*1+a$using Microsoft.EntityFrameworkCore;\nusing OrderManagement.Data;\nThen configure the database:\nvar builder = WebApplication.CreateBuilder(args);\n \nbuilder.Services.AddControllersWithViews();\n \nbuilder.Services.AddDbContext<ApplicationDbContext>(options =>\n    options.UseSqlServer(\n        builder.Configuration.GetConnectionString(\"DefaultConnection\")));\n \nvar app = builder.Build();\n \nif (!app.Environment.IsDevelopment())\n{\n    app.UseExceptionHandler(\"/Home/Error\");\n    app.UseHsts();\n}\n \napp.UseHttpsRedirection();\n \napp.UseRouting();\n \napp.UseAuthorization();\n \napp.MapStaticAssets();\n \napp.MapControllerRoute(\n    name: \"default\",\n    pattern: \"{controller=Home}/{action=Index}/{id?}\")\n    .WithStaticAssets();\n \napp.Run();","meta":{"author":"a.5Bma3U0RGBis5RkD","timestamp":1792480336504}},"pad:techofunction-week1:revs:392":{"changeset":"Z:1fj<s|1k=wx-s$","meta":{"author":"a.5Bma3U0RGBis5RkD","timestamp":1792480345564}},"pad:techofunction-week1:revs:393":{"changeset":"Z:1er>1|1k=wx*1+1$-","meta":{"author":"a.5Bma3U0RGBis5RkD","timestamp":1792480346869}},"pad:techofunction-week1:revs:394":{"changeset":"Z:1es>3|1k=wx=1*1+3$---","meta":{"author":"a.5Bma3U0RGBis5RkD","timestamp":1792480347434}},"pad:techofunction-week1:revs:395":{"changeset":"Z:1ev>4|1k=wx=4*1+4$----","meta":{"author":"a.5Bma3U0RGBis5RkD","timestamp":1792480348007}},"pad:techofunction-week1:revs:396":{"changeset":"Z:1ez>1|1k=wx=8*1+1$-","meta":{"author":"a.5Bma3U0RGBis5RkD","timestamp":1792480348613}},"pad:techofunction-week1:revs:397":{"changeset":"Z:1f0>1|2e=1el=a*d|1+1$\n","meta":{"author":"a.W8SlWkw9QzdnoaRT","timestamp":1792480950035}},"pad:techofunction-week1:revs:398":{"changeset":"Z:1f1>1|2f=1ew*d|1+1$\n","meta":{"author":"a.W8SlWkw9QzdnoaRT","timestamp":1792480950610}},"pad:techofunction-week1:revs:399":{"changeset":"Z:1f2>1|2g=1ex*d+1$=","meta":{"author":"a.W8SlWkw9QzdnoaRT","timestamp":1792480951219}},"pad:techofunction-week1:revs:400":{"changeset":"Z:1f3>2|2g=1ex=1*d+2$==","meta":{"author":"a.W8SlWkw9QzdnoaRT","timestamp":1792480951792,"pool":{"numToAttrib":{"0":["author","a.etherpad-system"],"1":["author","a.5Bma3U0RGBis5RkD"],"2":["heading","h3"],"3":["insertorder","first"],"4":["list","bullet1"],"5":["lmkr","1"],"6":["list","indent1"],"7":["list","indent3"],"8":["start","1"],"9":["author","a.XBtqZgC04nCR1sC5"],"10":["author","a.oIZ496sC0MvFJBbg"],"11":["list","indent2"],"12":["author","a.6fEK8VUdbD4cP299"],"13":["author","a.W8SlWkw9QzdnoaRT"]},"attribToNum":{"author,a.etherpad-system":0,"author,a.5Bma3U0RGBis5RkD":1,"heading,h3":2,"insertorder,first":3,"list,bullet1":4,"lmkr,1":5,"list,indent1":6,"list,indent3":7,"start,1":8,"author,a.XBtqZgC04nCR1sC5":9,"author,a.oIZ496sC0MvFJBbg":10,"list,indent2":11,"author,a.6fEK8VUdbD4cP299":12,"author,a.W8SlWkw9QzdnoaRT":13},"nextNum":14},"atext":{"text":"*Welcome for the training on Techno functional training program\nAgenda:\n  1.  Introduction\n  2.   LET  portal \n  3.   Day schedule (9 30am to 6 30pm)\n*    11 30  (20 minutes)\n* Lunch 1 30 ( 60 minute)\n*4  (20 minute)\n*\n   4. Lab guidance\n   5. Courseware\n   6. TOC\n   \n   9664670840\n   \n*   https://linuxlab.koenig-solutions.com\n*   Pa$$w0rd\n==================================================================================================\nApllication development:\n    Monolithic: \n    Microservice:\n        \n        components:\n            1)frontend ==>dotnet==>EFcore\n\n=================================\nSQL server==>DB server\n\nSSMS ==>Db client\n\nCRUD operation\n\nblameless postmortum\n\ncode===>build===>test==>deploy===>maintain\n==========================================\nAccount required for training:\n    ------------------------------------\ngithub\ndocker hub\nredhat\n==========================================\nDatabase\nUI\n\nDTO===>ORM\n=============================================\n*Day 2: 20/10/20\n\n\nhttps://github.com/Mudassir-dev0ps/dotnetSampleApp\n\nMVC\n============================================================\nusing Microsoft.EntityFrameworkCore;\nusing OrderManagement.Data;\n---------\nvar builder = WebApplication.CreateBuilder(args);\n \nbuilder.Services.AddControllersWithViews();\n \nbuilder.Services.AddDbContext<ApplicationDbContext>(options =>\n    options.UseSqlServer(\n        builder.Configuration.GetConnectionString(\"DefaultConnection\")));\n \nvar app = builder.Build();\n \nif (!app.Environment.IsDevelopment())\n{\n    app.UseExceptionHandler(\"/Home/Error\");\n    app.UseHsts();\n}\n \napp.UseHttpsRedirection();\n \napp.UseRouting();\n \napp.UseAuthorization();\n \napp.MapStaticAssets();\n \napp.MapControllerRoute(\n    name: \"default\",\n    pattern: \"{controller=Home}/{action=Index}/{id?}\")\n    .WithStaticAssets();\n \napp.Run();\n\n===\n\n\n\n\n","attribs":"*1*2*3*4*5*8+1*1|5+45*1*3*6*5+1*1|1+o*1*3*6*5+1*1|1+p*1*3*6*5+1*1|1+f*1*3*6*5+1*1|7+1x*a*3*6*5+1*1+f*a|1+q*a*3*6*5+1*a+b*1|2+2s*1+2*a+1*1|m+bo*1+6*9|1+1*1|6+35*1*2*3*5+1*1|13+n8*1+a*d|2+2*d+3*1|3+3*9|1+1|1+1"}}},"pad:techofunction-week1:revs:401":{"changeset":"Z:1f5>4|2g=1ex=3*d+4$====","meta":{"author":"a.W8SlWkw9QzdnoaRT","timestamp":1792480952363}},"pad:techofunction-week1:revs:402":{"changeset":"Z:1f9>4|2g=1ex=7*d+4$====","meta":{"author":"a.W8SlWkw9QzdnoaRT","timestamp":1792480952936}},"pad:techofunction-week1:revs:403":{"changeset":"Z:1fd>1|2g=1ex=b*d|1+1$\n","meta":{"author":"a.W8SlWkw9QzdnoaRT","timestamp":1792480955183}},"pad:techofunction-week1:revs:404":{"changeset":"Z:1fe>fr|2h=1f9*d|l+fq*d+1$using System.ComponentModel.DataAnnotations;using System.ComponentModel.DataAnnotations.Schema;\nnamespace OrderManagement.Models\n{\n    public class Order\n    {\n        public int OrderId { get; set; }\n\n        [Required]\n        public string ProductName { get; set; } = string.Empty;\n\n        public int Quantity { get; set; }\n\n        [Column(TypeName = \"decimal(18,2)\")]\n        public decimal Price { get; set; }\n\n        public DateTime OrderDate { get; set; }\n\n        public int CustomerId { get; set; }\n\n        public Customer? Customer { get; set; }\n    }\n}","meta":{"author":"a.W8SlWkw9QzdnoaRT","timestamp":1792480956710}},"pad:techofunction-week1:revs:405":{"changeset":"Z:1v5>1|32=1uz=1*d|1+1$\n","meta":{"author":"a.W8SlWkw9QzdnoaRT","timestamp":1792481051718}},"pad:techofunction-week1:revs:406":{"changeset":"Z:1v6>2|33=1v1*d|1+1*d+1$\n=","meta":{"author":"a.W8SlWkw9QzdnoaRT","timestamp":1792481052287}},"pad:techofunction-week1:revs:407":{"changeset":"Z:1v8>6|34=1v2=1*d+6$======","meta":{"author":"a.W8SlWkw9QzdnoaRT","timestamp":1792481052856}},"pad:techofunction-week1:revs:408":{"changeset":"Z:1ve>m|34=1v2=7*d+m$======================","meta":{"author":"a.W8SlWkw9QzdnoaRT","timestamp":1792481053556}},"pad:techofunction-week1:revs:409":{"changeset":"Z:1w0>1|34=1v2=t*d|1+1$\n","meta":{"author":"a.W8SlWkw9QzdnoaRT","timestamp":1792481054126}},"pad:techofunction-week1:revs:410":{"changeset":"Z:1w1>41|35=1vw*d|2+3z*d+2$\"ConnectionStrings\": {\n  \"DefaultConnection\": \"Server=BASESRV;Database=OrderManagementDb;Trusted_Connection=True;TrustServerCertificate=True;\"\n},","meta":{"author":"a.W8SlWkw9QzdnoaRT","timestamp":1792481054694}},"pad:techofunction-week1:revs:411":{"changeset":"Z:202<s1|1i=v4|17-qa-1r$","meta":{"author":"a.5Bma3U0RGBis5RkD","timestamp":1792481906076}},"pad:techofunction-week1:revs:412":{"changeset":"Z:181<cq|1k=v6|g-co-2$","meta":{"author":"a.5Bma3U0RGBis5RkD","timestamp":1792481913356}},"pad:techofunction-week1:revs:413":{"changeset":"Z:vb>bn|1i=v4*1|i+bn$using Microsoft.EntityFrameworkCore;\nusing OrderManagement.Models;