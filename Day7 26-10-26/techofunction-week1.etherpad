GlguTDX"],"22":["author","a.xz6wKKS5j76kPjlD"],"23":["author","a.rS0d1d8BEKDUrt1E"]},"attribToNum":{"author,a.etherpad-system":0,"author,a.5Bma3U0RGBis5RkD":1,"heading,h3":2,"insertorder,first":3,"list,bullet1":4,"lmkr,1":5,"list,indent1":6,"list,indent3":7,"start,1":8,"author,a.XBtqZgC04nCR1sC5":9,"author,a.oIZ496sC0MvFJBbg":10,"list,indent2":11,"author,a.6fEK8VUdbD4cP299":12,"author,a.W8SlWkw9QzdnoaRT":13,"heading,h2":14,"list,indent4":15,"list,indent10":16,"list,indent9":17,"list,indent8":18,"list,indent7":19,"list,indent6":20,"author,a.v1tf3cnZGGlguTDX":21,"author,a.xz6wKKS5j76kPjlD":22,"author,a.rS0d1d8BEKDUrt1E":23},"nextNum":24},"atext":{"text":"*Welcome for the training on Techno functional training program\nAgenda:\n  1.  Introduction\n  2.   LET  portal \n  3.   Day schedule (9 30am to 6 30pm)\n*    11 30  (20 minutes)\n* Lunch 1 30 ( 60 minute)\n*4  (20 minute)\n*\n   4. Lab guidance\n   5. Courseware\n   6. TOC\n   \n   9664670840\n   \n*   https://linuxlab.koenig-solutions.com\n*   Pa$$w0rd\n==================================================================================================\nApllication development:\n    Monolithic: \n    Microservice:\n        \n        components:\n            1)frontend ==>dotnet==>EFcore\n\n=================================\nSQL server==>DB server\n\nSSMS ==>Db client\n\nCRUD operation\n\nblameless postmortum\n\ncode===>build===>test==>deploy===>maintain\n==========================================\nAccount required for training:\n    ------------------------------------\ngithub\ndocker hub\nredhat\n==========================================\nDatabase\nUI\n\nDTO===>ORM\n=============================================\n*Day 2: 20/10/20\n\n\nhttps://github.com/Mudassir-dev0ps/dotnetSampleApp\n\nMVC\n============================================================\nusing Microsoft.EntityFrameworkCore;\nusing OrderManagement.Models;\n \nnamespace OrderManagement.Data\n{\n    public class ApplicationDbContext : DbContext\n    {\n        public ApplicationDbContext(\n            DbContextOptions<ApplicationDbContext> options)\n            : base(options)\n        {\n        }\n \n        public DbSet<Customer> Customers { get; set; }\n \n        public DbSet<Order> Orders { get; set; }\n    }\n}\n\n\n=\ndll===> format===>published application\n=========================================\nvar builder = WebApplication.CreateBuilder(args);\n \nvar app = builder.Build();\n \napp.MapGet(\"/\", () =>\n    \"Hello! My .NET application is running.\");\n \napp.MapGet(\"/about\", () => new\n{\n    Application = \"BuildPublishDemo\",\n    Technology = \"ASP.NET Core\",\n    Status = \"Running\"\n});\n \napp.MapGet(\"/health\", () => new\n{\n    Status = \"Healthy\",\n    Time = DateTime.UtcNow\n});\n \napp.Run();\n\n============================================================================\n*Day 3: 21/10/23\n\nDay 6 – Windows Server Fundamentals\n•\nWindows Server architecture\n•\nWindows Server editions\n•\nSystem configuration\n•\nWindows Server roles\n•\nServer Manager\n•\nUsers and groups\n•\nLocal vs domain accounts\n•\nActive Directory overview\n•\nGroup concepts\n•\nUser management\n•\nHands-on user/group administration\n\n======================================================\nOS\ndependencies\nlibraries\nApp code\n===========================================\n\nIdentity management ===>Authentication=================>IAM\nAccess managennt====>Authorization\n\nAD=============>Windows\nLDAP===========>Linux\nEntra ID====>Azure\nIAM===>AWS\n============================================================\nThe participants will act as junior Windows Server administrators for a fictional company. They will configure a server, install roles, create users and groups, deploy Active Directory, and troubleshoot access and account-management issues.\n\n1 role==>UI\n1 role==powershell\n------------------------------------------\nlocal user\n2 local group\n------------------------------------------------------------\nAD\nlocal user\n2 local graoup\n------------------------------------\n===================================================================\n*Day 3 22/10/26\n*Windows Filesystem & Permissions\n•\nWindows filesystem\n•\nDrives and partitions\n•\nNTFS\n•\nFile and folder permissions\n•\nNTFS permissions\n•\nShare permissions\n•\nPermission inheritance\n•\nOwnership\n•\nAdministrative shares\n•\nDisk space troubleshooting\n=============================================\n3GB====10x3==1000\n3GiB===2x10=3072\n==========================\nFolder1==========>f1,f2===>content ===================>UI\nFolder2=========>f3,f4========>content===========>Powershell\n\n*Access:          Folder          FIles\n    Read                  \n    Write \n    Execute \n    \n    ACL====> access control list          \n    ACE   \n    \n    icacls (powershell command for ACL access)\n    https://learn.microsoft.com/en-us/windows-server/administration/windows-commands/icacls#:~:text=A%20sequence%20of%20simple%20rights,%2D%20Read%20and%20execute%20access\n    \n    \n#icacls C:\\NTFSDemo\\Finance /grant \"FinanceLab:(OI)(CI)M\"\n\n---------------------------------------------------------------------------------------------\n\n    \n    Learning principle\n    1)simple to complex\n    2)real to imaginary\n    3)part to whole\n    \n    =====================================================\n    Ownership:\n    -------------------------\n    \n    \n    \n \n------------------------------------------------------------\nRDP\n  \n   run -> sysdm.cpl ->remote-> allow remote connection to this computer\n\n  RDP-  Enable-NetFirewallRule -DisplayGroup \"Remote Desktop\" |  Select-Object DisplayName, Enabled, Profile\n-----------------------------------------------------------\n\n    ================================\n    Network file sharing\n    \n    SMB\n\noct19jr-tfaodp\nPa$$w0rdR#    RDP-  Enable-NetFirewallRule -DisplayGroup \"Remote Desktop\" |  Select-Object DisplayName, Enabled, Profile\n    \n   - \n    \n","attribs":"*1*2*3*4*5*8+1*1|5+45*1*3*6*5+1*1|1+o*1*3*6*5+1*1|1+p*1*3*6*5+1*1|1+f*1*3*6*5+1*1|7+1x*a*3*6*5+1*1+f*a|1+q*a*3*6*5+1*a+b*1|2+2s*1+2*a+1*1|m+bo*1+6*9|1+1*1|6+35*1*2*3*5+1*1|p+fe*d|3+4*1|m+cq*1+a*d|2+2*1|1+25*1*2*3*5+1*1|u+b4*1+8*9|1+1*1|g+gt*1+a*d+1*1|7+5i*1*e*3*5+1*1|1+f*1*2*3*5+1*1|s+d4*1*3*6*5+1*1|b+ai*1+4*a|1+1*1|4+4a*a|1+5*a+4*1|3+1v*1+j*a|2+6*a+4*1|2+1x*1+t*a|c+94*1|4+1w*1+7*l|1+1*a|1+1*m+e*1|1+1*1+a*a+4*n+2y*a|2+6*a+3*1+1*a|1+2*a+4|1+1"}}},"pad:techofunction-week1:revs:1101":{"changeset":"Z:3xp>6|6c=3xe=4*1+6$------","meta":{"author":"a.5Bma3U0RGBis5RkD","timestamp":1792670306290}},"pad:techofunction-week1:revs:1102":{"changeset":"Z:3xv>j|6c=3xe=a*1+j$-------------------","meta":{"author":"a.5Bma3U0RGBis5RkD","timestamp":1792670306865}},"pad:techofunction-week1:revs:1103":{"changeset":"Z:3ye>c|6c=3xe=t*1+c$------------","meta":{"author":"a.5Bma3U0RGBis5RkD","timestamp":1792670307444}},"pad:techofunction-week1:revs:1104":{"changeset":"Z:3yq>4|6c=3xe=15*1|1+1*1+3$\n   ","meta":{"author":"a.5Bma3U0RGBis5RkD","timestamp":1792670307956}},"pad:techofunction-week1:revs:1105":{"changeset":"Z:3yu>1|6d=3yk=3*1+1$A","meta":{"author":"a.5Bma3U0RGBis5RkD","timestamp":1792670308515}},"pad:techofunction-week1:revs:1106":{"changeset":"Z:3yv<1|6d=3yk=3-1$","meta":{"author":"a.5Bma3U0RGBis5RkD","timestamp":1792670310275}},"pad:techofunction-week1:revs:1107":{"changeset":"Z:3yu>5g|6d=3yk=4*1|c+5c*1+4$    \nC$\n      \nAccess the C: drive remotely\n        \nD$\n      \nAccess the D: drive remotely, if available\n        \nADMIN$\n      \nAccess the Windows installation directory, usually  C:\\Windows\n    ","meta":{"author":"a.5Bma3U0RGBis5RkD","timestamp":1792670311561}},"pad:techofunction-week1:revs:1108":{"changeset":"Z:44a<1|61=3mn=30|1-1$","meta":{"author":"a.XBtqZgC04nCR1sC5","timestamp":1792670319153}},"pad:techofunction-week1:revs:1109":{"changeset":"Z:449>1|61=3mn=30*9|1+1$\n","meta":{"author":"a.XBtqZgC04nCR1sC5","timestamp":1792670319762}}