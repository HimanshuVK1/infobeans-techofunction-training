Bma3U0RGBis5RkD","timestamp":1792740813609}},"pad:techofunction-week1:revs:1489":{"changeset":"Z:6an>1|7o=4xb=7*1+1$ ","meta":{"author":"a.5Bma3U0RGBis5RkD","timestamp":1792740814160}},"pad:techofunction-week1:revs:1490":{"changeset":"Z:6ao>2|7o=4xb=8*1+2$re","meta":{"author":"a.5Bma3U0RGBis5RkD","timestamp":1792740814711}},"pad:techofunction-week1:revs:1491":{"changeset":"Z:6aq>3|7o=4xb=a*1+3$que","meta":{"author":"a.5Bma3U0RGBis5RkD","timestamp":1792740815260}},"pad:techofunction-week1:revs:1492":{"changeset":"Z:6at>2|7o=4xb=d*1+2$st","meta":{"author":"a.5Bma3U0RGBis5RkD","timestamp":1792740815813}},"pad:techofunction-week1:revs:1493":{"changeset":"Z:6av>5|7o=4xb=f*1|1+1*1+4$\n    ","meta":{"author":"a.5Bma3U0RGBis5RkD","timestamp":1792740832009}},"pad:techofunction-week1:revs:1494":{"changeset":"Z:6b0>1|7p=4xr=4*1+1$T","meta":{"author":"a.5Bma3U0RGBis5RkD","timestamp":1792740835091}},"pad:techofunction-week1:revs:1495":{"changeset":"Z:6b1>1|7p=4xr=5*1+1$r","meta":{"author":"a.5Bma3U0RGBis5RkD","timestamp":1792740835642}},"pad:techofunction-week1:revs:1496":{"changeset":"Z:6b2>2|7p=4xr=6*1+2$ue","meta":{"author":"a.5Bma3U0RGBis5RkD","timestamp":1792740836192}},"pad:techofunction-week1:revs:1497":{"changeset":"Z:6b4>1|7p=4xr=8*1+1$ ","meta":{"author":"a.5Bma3U0RGBis5RkD","timestamp":1792740837133}},"pad:techofunction-week1:revs:1498":{"changeset":"Z:6b5>1|7p=4xr=9*1+1$p","meta":{"author":"a.5Bma3U0RGBis5RkD","timestamp":1792740837760}},"pad:techofunction-week1:revs:1499":{"changeset":"Z:6b6>2|7p=4xr=a*1+2$os","meta":{"author":"a.5Bma3U0RGBis5RkD","timestamp":1792740838310}},"pad:techofunction-week1:revs:1500":{"changeset":"Z:6b8>2|7p=4xr=c*1+2$it","meta":{"author":"a.5Bma3U0RGBis5RkD","timestamp":1792740838858,"pool":{"numToAttrib":{"0":["author","a.etherpad-system"],"1":["author","a.5Bma3U0RGBis5RkD"],"2":["heading","h3"],"3":["insertorder","first"],"4":["list","bullet1"],"5":["lmkr","1"],"6":["list","indent1"],"7":["list","indent3"],"8":["start","1"],"9":["author","a.XBtqZgC04nCR1sC5"],"10":["author","a.oIZ496sC0MvFJBbg"],"11":["list","indent2"],"12":["author","a.6fEK8VUdbD4cP299"],"13":["author","a.W8SlWkw9QzdnoaRT"],"14":["heading","h2"],"15":["list","indent4"],"16":["list","indent10"],"17":["list","indent9"],"18":["list","indent8"],"19":["list","indent7"],"20":["list","indent6"],"21":["author","a.v1tf3cnZGGlguTDX"],"22":["author","a.xz6wKKS5j76kPjlD"],"23":["author","a.rS0d1d8BEKDUrt1E"],"24":["heading","h4"],"25":["author","a.aMGFTUQcz8IEZ3mm"],"26":["author","a.Fln8zZWwNdatIBJx"],"27":["author","a.4UVIp0q8OaxadHwV"]},"attribToNum":{"author,a.etherpad-system":0,"author,a.5Bma3U0RGBis5RkD":1,"heading,h3":2,"insertorder,first":3,"list,bullet1":4,"lmkr,1":5,"list,indent1":6,"list,indent3":7,"start,1":8,"author,a.XBtqZgC04nCR1sC5":9,"author,a.oIZ496sC0MvFJBbg":10,"list,indent2":11,"author,a.6fEK8VUdbD4cP299":12,"author,a.W8SlWkw9QzdnoaRT":13,"heading,h2":14,"list,indent4":15,"list,indent10":16,"list,indent9":17,"list,indent8":18,"list,indent7":19,"list,indent6":20,"author,a.v1tf3cnZGGlguTDX":21,"author,a.xz6wKKS5j76kPjlD":22,"author,a.rS0d1d8BEKDUrt1E":23,"heading,h4":24,"author,a.aMGFTUQcz8IEZ3mm":25,"author,a.Fln8zZWwNdatIBJx":26,"author,a.4UVIp0q8OaxadHwV":27},"nextNum":28},"atext":{"text":"*Welcome for the training on Techno functional training program\nAgenda:\n  1.  Introduction\n  2.   LET  portal \n  3.   Day schedule (9 30am to 6 30pm)\n*    11 30  (20 minutes)\n* Lunch 1 30 ( 60 minute)\n*4  (20 minute)\n*\n   4. Lab guidance\n   5. Courseware\n   6. TOC\n   \n   9664670840\n   \n*   https://linuxlab.koenig-solutions.com\n*   Pa$$w0rd\n==================================================================================================\nApllication development:\n    Monolithic: \n    Microservice:\n        \n        components:\n            1)frontend ==>dotnet==>EFcore\n\n=================================\nSQL server==>DB server\n\nSSMS ==>Db client\n\nCRUD operation\n\nblameless postmortum\n\ncode===>build===>test==>deploy===>maintain\n==========================================\nAccount required for training:\n    ------------------------------------\ngithub\ndocker hub\nredhat\n==========================================\nDatabase\nUI\n\nDTO===>ORM\n=============================================\n*Day 2: 20/10/20\n\n\nhttps://github.com/Mudassir-dev0ps/dotnetSampleApp\n\nMVC\n============================================================\nusing Microsoft.EntityFrameworkCore;\nusing OrderManagement.Models;\n \nnamespace OrderManagement.Data\n{\n    public class ApplicationDbContext : DbContext\n    {\n        public ApplicationDbContext(\n            DbContextOptions<ApplicationDbContext> options)\n            : base(options)\n        {\n        }\n \n        public DbSet<Customer> Customers { get; set; }\n \n        public DbSet<Order> Orders { get; set; }\n    }\n}\n\n\n=\ndll===> format===>published application\n=========================================\nvar builder = WebApplication.CreateBuilder(args);\n \nvar app = builder.Build();\n \napp.MapGet(\"/\", () =>\n    \"Hello! My .NET application is running.\");\n \napp.MapGet(\"/about\", () => new\n{\n    Application = \"BuildPublishDemo\",\n    Technology = \"ASP.NET Core\",\n    Status = \"Running\"\n});\n \napp.MapGet(\"/health\", () => new\n{\n    Status = \"Healthy\",\n    Time = DateTime.UtcNow\n});\n \napp.Run();\n\n============================================================================\n*Day 3: 21/10/23\n\nDay 6 – Windows Server Fundamentals\n•\nWindows Server architecture\n•\nWindows Server editions\n•\nSystem configuration\n•\nWindows Server roles\n•\nServer Manager\n•\nUsers and groups\n•\nLocal vs domain accounts\n•\nActive Directory overview\n•\nGroup concepts\n•\nUser management\n•\nHands-on user/group administration\n\n======================================================\nOS\ndependencies\nlibraries\nApp code\n===========================================\n\nIdentity management ===>Authentication=================>IAM\nAccess managennt====>Authorization\n\nAD=============>Windows\nLDAP===========>Linux\nEntra ID====>Azure\nIAM===>AWS\n============================================================\nThe participants will act as junior Windows Server administrators for a fictional company. They will configure a server, install roles, create users and groups, deploy Active Directory, and troubleshoot access and account-management issues.\n\n1 role==>UI\n1 role==powershell\n------------------------------------------\nlocal user\n2 local group\n------------------------------------------------------------\nAD\nlocal user\n2 local graoup\n------------------------------------\n===================================================================\n*Day 3 22/10/26\n*Windows Filesystem & Permissions\n•\nWindows filesystem\n•\nDrives and partitions\n•\nNTFS\n•\nFile and folder permissions\n•\nNTFS permissions\n•\nShare permissions\n•\nPermission inheritance\n•\nOwnership\n•\nAdministrative shares\n•\nDisk space troubleshooting\n=============================================\n3GB====10x3==1000\n3GiB===2x10=3072\n==========================\nFolder1==========>f1,f2===>content ===================>UI\nFolder2=========>f3,f4========>content===========>Powershell\n\n*Access:          Folder          FIles\n    Read                  \n    Write \n    Execute \n    \n    ACL====> access control list          \n    ACE   \n    \n    icacls (powershell command for ACL access)\n    https://learn.microsoft.com/en-us/windows-server/administration/windows-commands/icacls#:~:text=A%20sequence%20of%20simple%20rights,%2D%20Read%20and%20execute%20access\n    \n    \n#icacls C:\\NTFSDemo\\Finance /grant \"FinanceLab:(OI)(CI)M\"\n\n---------------------------------------------------------------------------------------------\n\n    \n    Learning principle\n    1)simple to complex\n    2)real to imaginary\n    3)part to whole\n    \n    =====================================================\n    Ownership:\n    -------------------------\n    \n    \n    \n \n------------------------------------------------------------\nRDP\n  \n   run -> sysdm.cpl ->remote-> allow remote connection to this computer\n\n  RDP-  Enable-NetFirewallRule -DisplayGroup \"Remote Desktop\" |  Select-Object DisplayName, Enabled, Profile\n  \n  Add user to Remote Desktop User group in win22 VM\n-----------------------------------------------------------\n\n    ================================\n    Network file sharing\n    \n    SMB\n\noct19jr-tfaodp\nPa$$w0rdR#    RDP-  Enable-NetFirewallRule -DisplayGroup \"Remote Desktop\" |  Select-Object DisplayName, Enabled, Profile\n    \n   --------------------------------------\n \nAdministrative shares:\n       \nC$     Access the C: drive remotely\n        \nD$       Access the D: drive remotely, if available\n        \nADMIN$   Access the Windows installation directory, usually  C:\\Windows\n=========================================================================================\n*Day5 23/10/26    \n    \n*Windows Processes & Services\n\nProcesses\nThreads Services\nService dependencies\nWindows Services console\nTask Manager\nResource Monitor\nCPU troubleshooting\nMemory troubleshooting\nService startup failures\nService recovery\n===========================================================\nProcess vs Program\n\nmultiprogramming vs multiprocessing\n\nwindows==>run===>dxdiag\n\nProcess & Parent Process ->\n Get-CimInstance Win32_Process | Select-Object Name, ProcessId, @{Name=\"ParentName\"; Expression={(Get-CimInstance Win32_Process -Filter \"ProcessId = $($_.ParentProcessId)\").Name}}, ParentProcessId | Format-Table -AutoSize\n\n\ntasklist /svc\n\n\nTypes of processes:\n    1)foreground: 80% resource\n    2)background: 20 % resource\n    ==============================================\n    Process vs. Daemons\n    Service==============>daemon\n    Restart/Reload\n    ---------------------------\n    100 request\n    True posit\n\n-------------------------------------------------------------------------------------------------------\nMultithreading demonstration\n-------------------\nimport threading, time\n\ndef task(n):\n    print(f\"Task {n} started\")\n    time.sleep(2)          # simulates waiting (API/DB call)\n    print(f\"Task {n} done\")\n\nstart = time.time()\nthreads = [threading.Thread(target=task, args=(i,)) for i in range(4)]\nfor t in threads: t.start()\nfor t in threads: t.join()\nprint(f\"Total: {time.time() - start:.1f}s\")   # ~2s, not 8s\n\n=====================================================\n\nMultiprocessing .\n\nimport multiprocessing, time\n\ndef burn_cpu(n):\n    total = 0\n    for i in range(30_000_000):\n        total += i * i\n    print(f\"Process {n} done\")\n\nif __name__ == \"__main__\":      # required on Windows\n    start = time.time()\n    procs = [multiprocessing.Process(target=burn_cpu, args=(i,)) for i in range(4)]\n    for p in procs: p.start()\n    for p in procs: p.join()\n    print(f\"Total: {time.time() - start:.1f}s\")\n\n============================================================\n\nPython Releases for Windows | Python.org\n\n 1 -   $url = \"https://www.python.org/ftp/python/3.14.2/python-3.14.2-amd64.exe\"            >> Invoke-WebRequest -Uri $url -OutFile \"$env:TEMP\\python-installer.exe\"  \n \n2 -   $pythonDir = \"$env:LOCALAPPDATA\\Programs\\Python\\Python314\"\n$scriptsDir = \"$pythonDir\\Scripts\"\n\n$userPath = [Environment]::GetEnvironmentVariable(\"Path\", \"User\")\n$entries = @($userPath -split ';' | Where-Object { $_ })\n\nforeach ($dir in @($pythonDir, $scriptsDir)) {\n    if ($entries -notcontains $dir) {\n        $entries += $dir\n    }\n}\n\n[Environment]::SetEnvironmentVariable(\n    \"Path\",\n    ($entries -join ';'),\n    \"User\"\n)\n\n$env:Path = \"$pythonDir;$scriptsDir;$env:Path\"\n\n\n","attribs":"*1*2*3*4*5*8+1*1|5+45*1*3*6*5+1*1|1+o*1*3*6*5+1*1|1+p*1*3*6*5+1*1|1+f*1*3*6*5+1*1|7+1x*a*3*6*5+1*1+f*a|1+q*a*3*6*5+1*a+b*1|2+2s*1+2*a+1*1|m+bo*1+6*9|1+1*1|6+35*1*2*3*5+1*1|p+fe*d|3+4*1|m+cq*1+a*d|2+2*1|1+25*1*2*3*5+1*1|u+b4*1+8*9|1+1*1|g+gt*1+a*d+1*1|7+5i*1*e*3*5+1*1|1+f*1*2*3*5+1*1|s+d4*1*3*6*5+1*1|b+ai*1+4*a|1+1*1|4+4a*a|1+5*a+4*1|3+1v*1+j*a|2+6*a+4*1|2+1x*1+t*a|c+7j*a+1f*9|1+1*a|1+1o*1|4+1w*1+7*l|1+1*a|1+1*m+e*1|1+1*1+a*a+4*n+2y*a|2+6*a+3*1|3+1s*1+2*a+1*1|7+7l*1*e*3*5+1*1+h*a|1+1*a+4*1|1+1*1*o*3*5+1*m+s*1|i+97*9|1+1*a|2+6y*p|2+2*p+d*a|3+3*1|9+76*1+e*a|2+2*a+u*1|1+22*1+5*a+9*1|2+z*a|v+ns*1|2+1q*a|1+1*l+14*r|2+2*r+4l*q+1*r|k+c6*r+1a*q|2+2|1+1"}}},"pad:techofunction-week1:revs:1501":{"changeset":"Z:6ba>2|7p=4xr=e*1+2$iv","meta":{"author":"a.5Bma3U0RGBis5RkD","timestamp":1792740839410}},"pad:techofunction-week1:revs:1502":{"changeset":"Z:6bc>2|7p=4xr=g*1+2$e ","meta":{"author":"a.5Bma3U0RGBis5RkD","timestamp":1792740839959}},"pad:techofunction-week1:revs:1503":{"changeset":"Z:6be>1|7p=4xr=i*1+1$/","meta":{"author":"a.5Bma3U0RGBis5RkD","timestamp":1792740840546}},"pad:techofunction-week1:revs:1504":{"changeset":"Z:6bf>1|7p=4xr=j*1+1$F","meta":{"author":"a.5Bma3U0RGBis5RkD","timestamp":1792740841098}},"pad:techofunction-week1:revs:1505":{"changeset":"Z:6bg>2|7p=4xr=k*1+2$al","meta":{"author":"a.5Bma3U0RGBis5RkD","timestamp":1792740841649}},"pad:techofunction-week1:revs:1506":{"changeset":"Z:6bi>3|7p=4xr=m*1+3$se ","meta":{"author":"a.5Bma3U0RGBis5RkD","timestamp":1792740842212}},"pad:techofunction-week1:revs:1507":{"changeset":"Z:6bl>2|7p=4xr=p*1+2$po","meta":{"author":"a.5Bma3U0RGBis5RkD","timestamp":1792740842762}},"pad:techofunction-week1:revs:1508":{"changeset":"Z:6bn>2|7p=4xr=r*1+2$si","meta":{"author":"a.5Bma3U0RGBis5RkD","timestamp":1792740843312}},"pad:techofunction-week1:revs:1509":{"changeset":"Z:6bp>2|7p=4xr=t*1+2$ti","meta":{"author":"a.5Bma3U0RGBis5RkD","timestamp":1792740843875}},"pad:techofunction-week1:revs:1510":{"changeset":"Z:6br>2|7p=4xr=v*1+2$ve","meta":{"author":"a.5Bma3U0RGBis5RkD","timestamp":1792740844426}},"pad:techofunction-week1:revs:1511":{"changeset":"Z:6bt>1|7p=4xr=x*1+1$ ","meta